# Pinned inputs of the golden image (vm/build.sh). Every download is checked
# against the SHA-256 here; a changed input is a changed recipe, so change
# this file in its own commit.

# Ubuntu 26.04 LTS cloud image, the dated release (never "current").
UBUNTU_IMAGE_URL=https://cloud-images.ubuntu.com/releases/resolute/release-20261108/ubuntu-26.04-server-cloudimg-amd64.img
UBUNTU_IMAGE_SHA256=7b90593f5532b49b7e3fe3d2743f0d1f0d822e5b07cebcd8e00c0df8069ecab9

# The kernel every capture so far ran on. The image above ships it; the
# provisioning refuses any other running kernel and holds the packages.
KERNEL_RELEASE=7.0.0-43-generic
KERNEL_PACKAGE_VERSION=7.0.0-43.43

# The Ubuntu archive snapshot the packages below come from
# (snapshot.ubuntu.com), so apt resolves the same versions on every build.
APT_SNAPSHOT=20261108T000000Z
# Packages installed on top of the image, with their versions at the snapshot.
# nodejs and npm run the npm-packaged agents (Codex, OpenCode).
APT_PACKAGES="nodejs=22.22.1+dfsg+~cs22.19.15-1ubuntu1 npm=9.2.0~ds3-1 make gcc git python3 sqlite3 zstd"

# Go, the version CI's setup-go installs from go.mod (go 1.26.0).
GO_VERSION=1.26.0
GO_URL=https://go.dev/dl/go1.26.0.linux-amd64.tar.gz
GO_SHA256=aac1b08a0fb0c4e0a7c1555beb7b59180b05dfc5a3d62e40e9de90cd42f88235

# The agents, at the versions config/agents.json lists last.
# Claude Code: the vendor's native binary of that version (the file its
# installer downloads and checks against the release manifest).
CLAUDE_VERSION=2.1.306
CLAUDE_URL=https://downloads.claude.ai/claude-code-releases/2.1.306/linux-x64/claude
CLAUDE_SHA256=520bc6c1f40af466bd03a278b5ae1af1a2938bc7de5b9e5cb15526da20d71cfe
# Codex and OpenCode: npm packages, exact versions (their platform binaries are
# exact-version optional dependencies); the image manifest records the
# installed lock file's hash.
CODEX_VERSION=0.166.0
OPENCODE_VERSION=1.19.5
# agy: one executable. No versioned vendor download is known, so it comes from
# the operator's install (AGY_SOURCE, default the agy on PATH) into the local
# cache, checked against this hash.
AGY_VERSION=1.4.7
AGY_SHA256=40349135371a8ed1f1af1e9f8b741de99174ae9fce6380b96c2d1f543480af7a

# Codex's model catalog (the profile's model.catalog): private, the server's
# entry for the pinned model, so it comes from the operator's file
# (CODEX_CATALOG_SOURCE, default ~/.config/agent-trace/codex-catalog-0.166.0.json)
# into the local cache, checked against the hash the profile pins.
CODEX_CATALOG_FILE=codex-catalog-0.166.0.json
CODEX_CATALOG_SHA256=d1a0ac453cf7c4fac6b715373cd6dcf5f0824e6e47e54cb5b10dcdd6e9d2231f

# Disk and build machine.
IMAGE_DISK_SIZE=40G
BUILD_CPUS=4
BUILD_MEM=8G
